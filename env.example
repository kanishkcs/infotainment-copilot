# Database Configuration
# PostgreSQL connection string
DATABASE_URL="postgresql://username:password@localhost:5432/infotainment_copilot"

# Authentication
# NextAuth.js secret key (generate with: openssl rand -base64 32)
AUTH_SECRET="your-secret-key-here"

# AI Service
# Hugging Face API token for AI responses
# Get from: https://huggingface.co/settings/tokens
HUGGING_FACE_API_TOKEN="your-hugging-face-token"

# Maps & Traffic
# TomTom API key for maps and traffic data
# Get from: https://developer.tomtom.com/
TOMTOM_API_KEY="your-tomtom-api-key"

# Public TomTom API key (for client-side map rendering)
NEXT_PUBLIC_TOMTOM_API_KEY="your-tomtom-api-key"

# Weather Service (Optional - has fallback)
# OpenWeatherMap API key
# Get from: https://openweathermap.org/api
OPENWEATHER_API_KEY="your-openweather-api-key"

# Development
NODE_ENV="development"
NEXTAUTH_URL="http://localhost:3000"
